programa
{
	
	funcao inicio()
	{

	  inteiro n1, n2

    escreva ("Informe um numero: ")
    leia (n1)
    escreva ("Informe outro numero: ")
    leia (n2)

    se (n1 > n2)
    escreva ("O maior numero é: ", n1)
    senao se (n2 > n1)
    escreva ("O maior numero é: ", n2)

	}
}
