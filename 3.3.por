programa
{
	
	funcao inicio()
	{
		inteiro contador = 15
		real soma = 0.0 
		inteiro quantidade = 0
		
		enquanto (contador <= 100)
		{
			soma = soma + contador
			quantidade = quantidade + 1 
			contador = contador + 1
			}

		real media = soma / quantidade
		escreva ("A media é: ", media)
	}
}
