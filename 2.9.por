programa
{
	
	funcao inicio()
	{
	inteiro nascimento
	inteiro anoAtual =2026
	inteiro idade

	escreva ("Informee seu ano de nascimento: ")
	leia (nascimento)

	idade = anoAtual  - nascimento 

	se (idade >=18)
	{escreva ("Você é maior de idade, já pode votar!")}
	senao 
	{
	escreva ("Você é menor de idade, não pode votar")
	}
	
	
	}
}
