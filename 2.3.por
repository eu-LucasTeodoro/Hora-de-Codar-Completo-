programa {
  funcao inicio() {
    
    inteiro a, b, c 

    escreva ("Informe um numero: ")
    leia (a)
    escreva ("Informe outro numero: ")
    leia (b)
    escreva ("Informe mais um numero: ")
    leia (c)

  se (a > b e a > c)        
    {escreva  ("O maior é o A: ", a)}
  se (b > c e b > c)  
    {escreva ("O maior é o B: ", b)}
  se (c > a e c > b)
  {escreva ("O maior é o C:", c)}
  se (a == b e a == c )
  {escreva ("Os numeros sao iguais!")}
  }
}
