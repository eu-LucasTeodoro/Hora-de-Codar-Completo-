programa
{
	
	funcao inicio()
	{
		inteiro n1, n2, n3, n4, n5, n6
		real soma = 0.0 
		real media  
		
		escreva ("Informe um numero: ")
		leia (n1)
		escreva ("Informe um numero: ")
		leia (n2)
		escreva ("Informe um numero: ")
		leia (n3)
		escreva ("Informe um numero: ")
		leia (n4)
		escreva ("Informe um numero: ")
		leia (n5)
		escreva ("Informe um numero: ")
		leia (n6)

		escreva (n1, " ", n2, " ", n3, " ", n4, " ", n5, " ", n6)

		soma = (n1 + n2 + n3 + n4 + n5 + n6)
		media = soma/6

		escreva (" A soma dos numeros é, ", soma, "\n")
		escreva ("A média é: ")
	}
}
