programa
{
	
	funcao inicio()
	{
		inteiro N 
		inteiro contador = 1

		escreva ("Informe um numero: ")
		leia (N) 

		enquanto (contador <= N){
			escreva (contador,  "\n")
			contador = contador + 1
		}
		
	}
}
